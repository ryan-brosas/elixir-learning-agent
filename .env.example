# Optional .env values for protected operator routes and model defaults.
LA_VIEWER_TOKEN=replace-with-a-viewer-token
LA_OPERATOR_TOKEN=replace-with-an-operator-token
LA_ADMIN_TOKEN=replace-with-an-administrator-token

# Local Compose model mode needs no bearer token; protected operator routes still use the tokens above.
LA_LOCAL_DOGFOOD=true

# OpenAI-compatible endpoint the LEARNING FLEET calls (server-side).
# Inside Compose use http://host.docker.internal:11434/v1; for host-run Mix use http://127.0.0.1:11434/v1.
# You can also save the connection from Settings - it overrides this default.
LA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LA_MODEL=replace-with-a-model-id
LA_MODEL_API_KEY=
LA_MODEL_TIMEOUT_MS=15000
# Transient model failures (timeout, 429, connection, 5xx) retry this many times per call, including the first attempt.
LA_MODEL_RETRY_LIMIT=100

# Generated skills are locked to this directory (host path bind-mounted in Compose).
LA_SKILLS_ROOT=.agents/skills
# If that path is not writable (root-owned Docker volume), the app falls back to ./skills-data.
LA_SOURCE_ROOT=sources
LA_MAX_AUTO_PASSES=0
# 0 = keep learning a repo until unread source files are gone. A positive number is only a circuit breaker.
# Parallel learning passes. Each slot holds one graph at a time.
# Split across models on Settings (saved to data/runtime-settings.json), e.g. 20 on ds-pro and 20 on glm-5.3-flash.
LA_WORKER_SLOTS=1

# Localhost MCP. Compose maps these through host.docker.internal.
LA_CBM_HOST=127.0.0.1
LA_CBM_PORT=9749
LA_OV_HOST=127.0.0.1
LA_OV_PORT=1933
